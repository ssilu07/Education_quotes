<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_gradient">

    <!-- Decorative circles for depth -->
    <View
        android:id="@+id/circle_top"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-80dp"
        android:layout_marginEnd="-60dp"
        android:alpha="0"
        android:background="@drawable/splash_circle" />

    <View
        android:id="@+id/circle_bottom"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_gravity="bottom|start"
        android:layout_marginBottom="-60dp"
        android:layout_marginStart="-50dp"
        android:alpha="0"
        android:background="@drawable/splash_circle" />

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="40dp">

        <!-- Logo container with glow circle -->
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center">

            <View
                android:id="@+id/logo_glow"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/splash_circle" />

            <ImageView
                android:id="@+id/splash_logo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:alpha="0"
                android:scaleX="0.5"
                android:scaleY="0.5"
                android:src="@drawable/vocab_swap_logo" />
        </FrameLayout>

        <!-- App Name -->
        <TextView
            android:id="@+id/splash_app_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:alpha="0"
            android:fontFamily="@font/robotobold"
            android:letterSpacing="0.08"
            android:text="VOCAB TRICKS"
            android:textColor="#ffffff"
            android:textSize="32sp"
            android:translationY="30dp" />

        <!-- Tagline -->
        <TextView
            android:id="@+id/splash_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:alpha="0"
            android:letterSpacing="0.15"
            android:text="Learn Smart. Learn Fast."
            android:textColor="#bbffffff"
            android:textSize="15sp"
            android:translationY="20dp" />

        <!-- Animated divider line -->
        <View
            android:id="@+id/splash_divider"
            android:layout_width="0dp"
            android:layout_height="2dp"
            android:layout_marginTop="24dp"
            android:alpha="0"
            android:background="#55ffffff" />

        <!-- Feature highlights -->
        <TextView
            android:id="@+id/splash_features"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:alpha="0"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Vocab  |  Idioms  |  Quiz  |  AI Explain"
            android:textColor="#99ffffff"
            android:textSize="12sp"
            android:translationY="15dp" />

    </LinearLayout>

    <!-- Bottom Lottie animation -->
    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/splash_lottie"
        android:layout_width="180dp"
        android:layout_height="80dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="40dp"
        android:alpha="0"
        app:lottie_autoPlay="false"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/animation_lnh4z886" />

    <!-- Version text -->
    <TextView
        android:id="@+id/splash_version"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="16dp"
        android:alpha="0"
        android:text="v1.2.2"
        android:textColor="#66ffffff"
        android:textSize="11sp" />

</FrameLayout>
