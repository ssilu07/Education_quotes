<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surfaceBackground">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:minHeight="?attr/actionBarSize"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light" />

    <!-- Progress & Score Header -->
    <LinearLayout
        android:id="@+id/layout_quiz_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/cardBackground"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="8dp"
        android:elevation="2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_question_counter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Question 1 of 60"
                android:textColor="@color/textSecondary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_score_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#E8F5E9"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="Score: 0"
                android:textColor="#2E7D32"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/quiz_progress_bar"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="8dp"
            android:max="60"
            android:progress="1"
            android:progressTint="@color/colorPrimary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:id="@+id/scroll_quiz"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Quiz In-Progress Card Layout -->
            <LinearLayout
                android:id="@+id/layout_quiz_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Question Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_question"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="3dp"
                    app:cardBackgroundColor="@color/cardBackground">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="18dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:layout_marginBottom="10dp">

                            <TextView
                                android:id="@+id/tv_q_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#E0F7FA"
                                android:paddingHorizontal="8dp"
                                android:paddingVertical="3dp"
                                android:text="Q.1"
                                android:textColor="#00838F"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <View
                                android:layout_width="0dp"
                                android:layout_height="1dp"
                                android:layout_weight="1" />

                            <!-- Action buttons: TTS, Copy, Bookmark -->
                            <ImageView
                                android:id="@+id/btn_tts"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="12dp"
                                android:padding="4dp"
                                android:src="@drawable/ic_volume_up"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Listen"
                                app:tint="#757575" />

                            <ImageView
                                android:id="@+id/btn_copy"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_marginEnd="12dp"
                                android:padding="4dp"
                                android:src="@drawable/copy"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Copy"
                                app:tint="#757575" />

                            <ImageView
                                android:id="@+id/btn_bookmark"
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:padding="4dp"
                                android:src="@drawable/star"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="Bookmark"
                                app:tint="#757575" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_instruction"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textColor="@color/textSecondary"
                            android:textSize="14sp"
                            android:textStyle="normal"
                            android:lineSpacingExtra="3dp"
                            android:layout_marginBottom="6dp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/tv_question_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Question sentence goes here..."
                            android:textColor="@color/textPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:lineSpacingExtra="5dp"
                            android:layout_marginVertical="4dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Options -->
                <LinearLayout
                    android:id="@+id/layout_options"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Option A -->
                    <LinearLayout
                        android:id="@+id/opt_card_a"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_quiz_option"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_badge_a"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#EEEEEE"
                            android:gravity="center"
                            android:text="A"
                            android:textColor="#424242"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_opt_a"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Option A"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_icon_a"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option B -->
                    <LinearLayout
                        android:id="@+id/opt_card_b"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_quiz_option"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_badge_b"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#EEEEEE"
                            android:gravity="center"
                            android:text="B"
                            android:textColor="#424242"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_opt_b"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Option B"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_icon_b"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option C -->
                    <LinearLayout
                        android:id="@+id/opt_card_c"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_quiz_option"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_badge_c"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#EEEEEE"
                            android:gravity="center"
                            android:text="C"
                            android:textColor="#424242"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_opt_c"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Option C"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_icon_c"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <!-- Option D -->
                    <LinearLayout
                        android:id="@+id/opt_card_d"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:background="@drawable/bg_quiz_option"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="14dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackground">

                        <TextView
                            android:id="@+id/tv_badge_d"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="#EEEEEE"
                            android:gravity="center"
                            android:text="D"
                            android:textColor="#424242"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_opt_d"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="14dp"
                            android:text="Option D"
                            android:textColor="@color/textPrimary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <ImageView
                            android:id="@+id/iv_icon_d"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Explanation Card (Visible after answering) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/card_explanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:cardBackgroundColor="#F1F8E9">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:id="@+id/tv_explanation_title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Explanation:"
                            android:textColor="#2E7D32"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="6dp" />

                        <TextView
                            android:id="@+id/tv_explanation_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Detailed explanation of the rule..."
                            android:textColor="#263238"
                            android:textSize="15sp"
                            android:lineSpacingExtra="4dp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Next Question Button -->
                <Button
                    android:id="@+id/btn_next_question"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="24dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="Next Question ➔"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    app:cornerRadius="12dp" />

            </LinearLayout>

            <!-- Quiz Result Layout (Visible upon finishing all questions) -->
            <LinearLayout
                android:id="@+id/layout_result"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_result_emoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🏆"
                    android:textSize="64sp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tv_result_heading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quiz Completed!"
                    android:textColor="@color/textPrimary"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tv_result_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="You scored 55 out of 60"
                    android:textColor="#2E7D32"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tv_result_xp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+600 XP earned!"
                    android:textColor="@color/colorPrimaryDark"
                    android:textSize="15sp"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btn_reattempt"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginBottom="12dp"
                    android:backgroundTint="@color/colorPrimary"
                    android:text="🔄 Reattempt Quiz"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:cornerRadius="12dp" />

                <Button
                    android:id="@+id/btn_back_to_sets"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:backgroundTint="#757575"
                    android:text="⬅ Back to Sets"
                    android:textColor="@android:color/white"
                    android:textSize="16sp"
                    app:cornerRadius="12dp" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- DSSSB Questions List View (shows all questions in a vertical list) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_quiz_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="6dp"
        android:paddingBottom="80dp"
        android:visibility="gone" />

    <!-- Floating button to return to Quiz mode when in List mode -->
    <androidx.cardview.widget.CardView
        android:id="@+id/fab_quiz_view"
        android:layout_width="wrap_content"
        android:layout_height="46dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorPrimary"
        app:cardCornerRadius="23dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="Quiz View"
                android:src="@drawable/ic_cards_mode" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Quiz View"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</FrameLayout>

</LinearLayout>
